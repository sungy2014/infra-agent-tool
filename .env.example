# --- LLM Provider (openai or deepseek) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_REASONING_EFFORT=
DEEPSEEK_THINKING=disabled
AGNO_REASONING=false

# For DeepSeek use:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-v4-flash
# LLM_REASONING_EFFORT=high
# DEEPSEEK_THINKING=enabled

# --- Auth ---
# INFRA_AGENT_API_KEY=set-this-to-require-bearer-auth-on-all-endpoints

# --- Git / GitHub ---
GIT_REMOTE_URL=git@github.com:your-org/your-repo.git
GIT_BRANCH=main

# --- Jenkins ---
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=<your-token>
JENKINS_JOB_NAME=terraform-apply-pipeline

# --- Auth ---
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=admin123
# AUTH_SECRET=your-jwt-secret-key

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
